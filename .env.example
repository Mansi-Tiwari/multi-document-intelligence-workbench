# Copy to .env and adjust. Every value is validated with Zod at startup
# (apps/server/src/config/env.ts); invalid values stop the server.

NODE_ENV=development

# API server port. The web dev server proxies /api to this port.
PORT=3001

# Vite dev server port
WEB_PORT=5173

# SQLite file (relative to apps/server)
DATABASE_PATH=./data/workbench.sqlite

# mock | anthropic
LLM_PROVIDER=mock

# Only used when LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# Max documents analyzed in parallel (each in its own LLM call), 1-10
ANALYSIS_CONCURRENCY=3

# Browser origins allowed by CORS: comma-separated exact origins
# (scheme://host[:port], no path or trailing slash). Requests without an
# Origin header (curl, same-origin) are always allowed.
CORS_ORIGINS=http://localhost:5173

# Rate limit for /api (the health check is excluded): at most RATE_LIMIT_MAX
# requests per client IP per RATE_LIMIT_WINDOW_MS milliseconds.
# RATE_LIMIT_WINDOW_MS: 1000-3600000, RATE_LIMIT_MAX: 1-100000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
